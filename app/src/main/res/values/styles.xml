<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor" tools:targetApi="VANILLA_ICE_CREAM">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="VANILLA_ICE_CREAM">@android:color/transparent</item>
    </style>

    <!-- fix app title in toolbar too small in landscape on at least API36 -->
    <style name="ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
    </style>
</resources>
